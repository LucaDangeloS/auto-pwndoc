.home-drawer .q-router-link--active {
    background-color: $primary;
    opacity: 0.9;
    color: white!important;
}

.chip-center .q-chip-main {
    margin: auto;
}

// Make one line for each chip (for example in q-select)
.q-chip-one-line .q-chip {
    margin-right: 100%;
}

.dropzone {
    border: dashed;
    border-color: $blue;
    border-width: 2px;
    border-radius: 5px;
    height: 50px!important;
    color: $grey-8;
}

.vertical-center {
  margin: 0;
  position: absolute;
  top: 50%;
  -ms-transform: translateY(-50%);
  transform: translateY(-50%);
}

// For handling \n and tabs
.text-pre-wrap {
    white-space: pre-wrap;
}

.sticky-header-table
    /* height or max-height is important */
    max-height: calc(100vh - 82px)

    thead tr:first-child th
        border-bottom: 0

    thead tr:first-child th
        position: sticky
        z-index: 1
        top: 0

    /* this is when the loading indicator appears */
    &.q-table--loading thead tr:last-child th
        z-index: 2

    tr
        cursor: initial !important

    /* Sticky action column — always visible on the right */
    th:last-child,
    td:last-child
        position: sticky
        right: 0
        z-index: 1

.sticky-header-table-addfinding
    /* height or max-height is important */
    max-height: calc(100vh - 132px)

    thead tr:first-child th
        border-bottom: 0
        // border-bottom: 1px solid rgba(0,0,0,0.12)
    
    thead tr:first-child th
        position: sticky
        z-index: 1
        top: 0

    /* this is when the loading indicator appears */
    &.q-table--loading thead tr:last-child th
        z-index: 2

    tr
        cursor: initial !important

.loading-error .material-icons {
    font-size: 100px;
}

.loading-error p {
    font-size: 20px;
}

.loading-error:before {
    opacity: 0.7;
}

// Global page content side margins on mobile
// Quasar xs breakpoint is < 600px, sm is 600–1023px
@media (max-width: 1023px)
    .q-page-container .row > .col-12
        padding-left: 12px
        padding-right: 12px

// Settings page scroll offset for sticky header
[id^="section-"]
    scroll-margin-top: 16px

.settings-color-input .q-field__append
    padding-left: 8px

.settings-color-swatch
    display: inline-block
    width: 28px
    height: 28px
    min-height: 28px
    border: 1px solid $slate400
    border-radius: 50%
    background: var(--settings-color)
    vertical-align: middle

.settings-color-swatch--disabled
    cursor: not-allowed !important
    opacity: 0.45

.settings-color-picker-panel,
.settings-color-picker-panel .q-color-picker
    width: 260px

.body--dark .settings-color-swatch
    border-color: $slate600

.settings-review-section
    overflow: hidden

.settings-review-copy
    max-width: 100%
    white-space: normal
    overflow-wrap: anywhere
    line-height: 1.55

.settings-review-toggle
    border: 1px solid rgba(100, 116, 139, 0.3)
    border-radius: 10px
    overflow: hidden
    margin: 0

    .q-btn
        min-height: 38px
        white-space: normal
        line-height: 1.25
        padding: 8px 14px

.settings-review-controls
    display: flex
    align-items: flex-start
    gap: 20px
    flex-wrap: wrap

.settings-review-enable
    min-height: 56px
    display: flex
    align-items: center

.settings-review-number
    width: 180px
    max-width: 100%

@media (max-width: 599px)
    .settings-review-toggle
        display: flex
        flex-direction: column

        .q-btn
            width: 100%

    .settings-review-controls
        flex-direction: column
        gap: 12px

    .settings-review-number
        width: 100%

// Settings page side navigation
.settings-nav
    position: sticky
    top: 70px

    .q-item
        border-radius: 0 8px 8px 0
        min-height: 36px
        padding: 4px 12px
        margin-bottom: 2px
        border-left: 3px solid transparent
        transition: all 0.15s ease

.settings-nav-active
    border-left-color: $secondary !important
    background: rgba($secondary, 0.08) !important
    color: $secondary !important
    .q-item__label,
    .q-item-label
        color: $secondary !important
        font-weight: 600

.body--dark .settings-nav-active
    background: rgba($secondary, 0.15) !important
    color: #5eeadb !important
    .q-item__label,
    .q-item-label
        color: #5eeadb !important

// Dark mode overrides
// Custom fields preview area uses bg-grey-2 which is light in dark mode
.body--dark .bg-grey-2
    background-color: $slate700 !important

// Tab bars with hardcoded bg-white class
.body--dark .q-tabs.bg-white
    background-color: $slate800 !important

// CVSS calculator cards — the q-card bg-grey-1 class used in finding edit
.body--dark .bg-grey-1
    background-color: $slate800 !important

// AI loading animation
@keyframes ai-pulse
    0%, 100%
        opacity: 0.45
    50%
        opacity: 1

.ai-loading
    color: $secondary
    font-style: italic
    animation: ai-pulse 1.2s ease-in-out infinite

@media (prefers-reduced-motion: reduce)
    .ai-loading
        animation: none
        opacity: 0.85

// AI in-flight overlay (sits on top of editor body)
.ai-overlay
    position: absolute
    inset: 0
    z-index: 10
    display: flex
    align-items: center
    justify-content: center
    flex-direction: column
    gap: 12px
    background: rgba(255, 255, 255, 0.72)
    backdrop-filter: blur(2px)
    -webkit-backdrop-filter: blur(2px)
    border-radius: 4px
    pointer-events: auto
    user-select: none

.ai-overlay__label
    color: $purple-7
    font-weight: 500
    letter-spacing: 0.01em
    display: flex
    align-items: center
    gap: 6px

.body--dark .ai-overlay
    background: rgba(20, 24, 32, 0.78)

.body--dark .ai-overlay__label
    color: #d6b8ff

.ai-overlay__cancel
    margin-top: 6px

// Containers that host an ai-overlay must be position:relative
.ai-overlay-host
    position: relative

// Settings AI test results
.ai-test-row
    flex-wrap: wrap

.ai-test-result
    flex-wrap: nowrap
    max-width: 100%

.ai-test-message
    max-width: 640px
    max-height: 8em
    overflow-y: auto
    word-break: break-word
    white-space: pre-wrap

.taxonomy-empty
    color: #8a8f98
    font-weight: 600

.body--dark .taxonomy-empty
    color: rgba(255, 255, 255, 0.62)

.automatic-matching-btn
    background: $primary !important
    color: #ffffff !important
    border: 1px solid $primary !important
    min-height: 36px

    .q-icon
        color: inherit !important

.body--dark .automatic-matching-btn
    background: #5eeadb !important
    border-color: #5eeadb !important
    color: #102027 !important

@keyframes spin-slow
    from
        transform: rotate(0deg)
    to
        transform: rotate(360deg)

.rotate-anim
    animation: spin-slow 1.6s linear infinite

@media (prefers-reduced-motion: reduce)
    .rotate-anim
        animation: none
